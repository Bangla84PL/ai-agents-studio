# =============================================================================
# AI Agents Studio - Environment Variables
# =============================================================================
#
# Instructions:
# 1. Copy this file to .env.local for local development
# 2. Set these variables in Vercel dashboard for production
# 3. Never commit actual .env files to git
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application URL
# -----------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: Set automatically by Vercel or use your custom domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard → Settings → API
#
# Project URL: Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Key: Public key for client-side requests
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key: KEEP SECRET! Server-side only
# ⚠️ This key bypasses Row Level Security - never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# Integration URLs (OPTIONAL)
# -----------------------------------------------------------------------------
# These have sensible defaults but can be overridden

# n8n Workflow Automation
NEXT_PUBLIC_N8N_URL=https://n8n.smartcamp.ai

# Flowise AI Chatflow Builder
NEXT_PUBLIC_FLOWISE_URL=https://flowise.smartcamp.ai

# Gotenberg PDF Generation
NEXT_PUBLIC_GOTENBERG_URL=https://gotenberg.smartcamp.ai

# -----------------------------------------------------------------------------
# Future: Analytics (NOT IMPLEMENTED YET)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Future: Error Tracking (NOT IMPLEMENTED YET)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Node Environment (Set automatically by Vercel)
# -----------------------------------------------------------------------------
# NODE_ENV=development

# =============================================================================
# Vercel Deployment Notes:
# =============================================================================
#
# 1. Set environment variables in Vercel dashboard:
#    Project Settings → Environment Variables
#
# 2. Select which environments to apply to:
#    - Production: Main branch deployments
#    - Preview: PR deployments
#    - Development: Local with vercel dev
#
# 3. After adding/changing variables, redeploy:
#    vercel --prod
#
# =============================================================================
