# Vercel Ignore File
# Files and directories to exclude from Vercel deployment

# Documentation (not needed in production)
docs/
*.md
!README.md

# Tests
**/__tests__/
**/__mocks__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.js
jest.setup.js
coverage/

# Development files
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (managed in Vercel dashboard)
.env*
!.env.example

# Git
.git/
.gitignore

# Docker (not used on Vercel)
Dockerfile
docker-compose.yml
.dockerignore

# Branding source (already in public/)
branding/

# VPS specific
VPS_CONFIGURATION_GUIDE.md
DEPLOYMENT.md

# Supabase migrations (run separately)
/supabase/
